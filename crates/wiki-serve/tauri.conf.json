{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wiki Desktop",
  "version": "0.4.0",
  "identifier": "com.rust-tunnel.wiki",
  "build": {
    "frontendDist": "../../wiki-desktop-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../../wiki-desktop-ui",
    "beforeBuildCommand": "npm run build --prefix ../../wiki-desktop-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Wiki Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
