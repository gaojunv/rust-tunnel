# Server
BIND_ADDR=0.0.0.0:8080
API_ADDR=0.0.0.0:3000
DB_PATH=./data/rust-tunnel.db
PASSWORD=admin-password        # Web login password
CLIENT_TOKEN=change-me         # Client-side token (seeds server_auth)

# Client
SERVER_ADDR=tunnel.example.com:8080
PASSWORD=<client-token>
NAME=home-nas
TLS=true
TLS_INSECURE=true

# Mesh (optional)
# MESH_ID=my-network
# MESH_NAME=client-a
# MESH_SERVICES=db:mysql:localhost:3306,api:http:localhost:8080
