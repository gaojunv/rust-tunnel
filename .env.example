# Rust environment
PATH="$HOME/.cargo/bin:$PATH"

# Server configuration
# RUST_LOG=info
# RUST_TUNNEL_BIND=0.0.0.0:8080
# RUST_TUNNEL_API_BIND=0.0.0.0:3000

# DNS server configuration
# DNS_ENABLED=true
# DNS_BIND=0.0.0.0:53
# DNS_TUNNEL_DOMAIN=tunnel.local
# DNS_MESH_DOMAIN=mesh.local

# Database path (optional)
# DATABASE_URL=sqlite://data/rust-tunnel.db

# Client configuration
# SERVER_ADDR=your-server.com:8080
# AUTH_TOKEN=your_auth_token
# FORWARDS=8080:localhost:80,9000:localhost:3000

# Mesh configuration (client)
# MESH_ID=my-network
# MESH_NAME=client-a
# MESH_SERVICES=db:mysql:localhost:3306,api:http:localhost:8080
