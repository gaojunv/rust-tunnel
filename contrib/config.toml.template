# Rust Tunnel Server 配置文件
# 部署时由 GitHub Workflow 自动替换敏感信息占位符

# 控制通道监听地址
control_addr = "0.0.0.0:8080"

# API/前端监听地址
api_addr = "0.0.0.0:8081"

# Web 管理界面密码 (部署时替换)
admin_password = "${ADMIN_PASSWORD}"

# 客户端认证令牌 (部署时替换)
client_auth_token = "${CLIENT_AUTH_TOKEN}"

# 启用 TLS 加密 (自签名证书，首次启动时自动生成)
tls = true

# 自签名证书路径 (自动生成，无需手动配置)
tls_cert = "./data/tls/fullchain.pem"
tls_key = "./data/tls/privkey.key"

# 日志级别
log = "info"

# 数据库路径
db_path = "./data/rust-tunnel.db"

# 客户端二进制归档目录 (部署时替换为 DEPLOY_PATH 下的 client 子目录)
# release-client.yml 按 tag 落盘 <dir>/<tag>/，Web 下载页只读该目录。
# 用绝对路径而非 ./client：service 的 WorkingDirectory 是硬编码的
# /opt/rust-tunnel，与 DEPLOY_PATH 未必一致。
client_dist_dir = "${CLIENT_DIST_DIR}"

# wiki 桌面端安装包归档目录 (部署时替换为 DEPLOY_PATH 下的 wiki 子目录)
# release-wiki-client.yml 按 wiki-v* tag 落盘 <dir>/<version>/，Web 下载页的
# Wiki 桌面端分区只读该目录。绝对路径的理由同 client_dist_dir。
wiki_dist_dir = "${WIKI_DIST_DIR}"

# Shadowsocks 代理配置
ss_enabled = true
ss_port = 8388
ss_cipher = "aes-256-gcm"
# Shadowsocks 密码 (部署时替换)
ss_password = "${SS_PASSWORD}"

# Trojan 代理配置
trojan_enabled = true
trojan_port = 8443
# Trojan 认证密码 (部署时替换)
trojan_password = "${TROJAN_PASSWORD}"
# 认证失败时回退地址 (伪装为 HTTPS 站点)
trojan_fallback = "127.0.0.1:80"

# RustDesk 兼容服务配置 (hbbs 会合 + hbbr 中继，共用一个开关)
# 端口：21116 TCP+UDP (会合信令 + 心跳/打洞)、21115 TCP (NAT 探测，= 会合端口 - 1)、
# 21117 TCP (中继)。21116 的 UDP 半边是打洞成功的关键，防火墙只放 TCP 会退化为中继。
rustdesk_enabled = false
rustdesk_rendezvous_port = 21116
rustdesk_relay_port = 21117
# 密钥来自 Web UI (推荐：可轮换) 或 RUSTDESK_KEY / --rustdesk-key (基础设施托管)。
# 这里刻意留空、不放占位符：key 是密钥对而非共享口令，若由 CI 注入，之后在 Web UI
# 点「生成」轮换会被下一次部署覆盖，两者互相打架。
# rustdesk_key = "${RUSTDESK_KEY}"
# 不下发固定中继地址时留空，由客户端自行选择
# rustdesk_relay_server = "relay.example.com:21117"
# 强制客户端走中继
rustdesk_always_use_relay = false
# 内网直连场景下作为中继地址下发的本机 IP
# rustdesk_local_ip = "192.168.1.10"
# 内网判定掩码，形如 192.168.0.0/16；留空则不做内网判定
# rustdesk_mask = "192.168.0.0/16"
# RustDesk 四个监听(会合 TCP+UDP / NAT 探测 / 中继)绑定的本机 IP；默认 0.0.0.0。
# 只在启动时读取一次，改动需重启服务；Web 管理页不提供此项（基础设施级设置）。
# rustdesk_bind_addr = "0.0.0.0"

# DNS 服务器配置
dns_enabled = true
dns_bind = "0.0.0.0:53"
dns_tunnel_domain = "tunnel.local"
dns_mesh_domain = "mesh.local"
