# Rust Tunnel Server 配置文件
# 部署时由 GitHub Workflow 自动替换敏感信息占位符

# 控制通道监听地址
control_addr = "0.0.0.0:8080"

# API/前端监听地址
api_addr = "0.0.0.0:3000"

# Web 管理界面密码 (部署时替换)
admin_password = "${ADMIN_PASSWORD}"

# 客户端认证令牌 (部署时替换)
client_auth_token = "${CLIENT_AUTH_TOKEN}"

# 启用 TLS 加密 (自签名证书，首次启动时自动生成)
tls = true

# 自签名证书路径 (自动生成，无需手动配置)
tls_cert = "./data/tls/cert.pem"
tls_key = "./data/tls/key.pem"

# 日志级别
log = "info"

# 数据库路径
db_path = "./data/rust-tunnel.db"

# Shadowsocks 代理配置
ss_enabled = true
ss_port = 8388
ss_cipher = "aes-256-gcm"
# Shadowsocks 密码 (部署时替换)
ss_password = "${SS_PASSWORD}"
